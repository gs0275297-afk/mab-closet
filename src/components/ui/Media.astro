---
/**
 * Moldura de fotografia.
 * Gera AVIF/WebP em vários tamanhos, reserva a proporção (sem saltos de
 * layout) e expõe as camadas de máscara, parallax e zoom usadas no site.
 *
 * Para trocar uma foto, basta substituir o arquivo em src/assets/images/.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Atributo `sizes` — largura real ocupada pela imagem em cada breakpoint. */
  sizes: string;
  /** Proporção da moldura. Padrão: a proporção da própria foto. */
  ratio?: string;
  /** Direção da máscara de entrada. */
  reveal?: 'up' | 'down' | 'left' | 'right' | 'center' | 'none';
  /** Intensidade do parallax interno (0 desliga). */
  parallax?: number;
  /** object-position da foto dentro da moldura. */
  position?: string;
  /** Atraso da entrada, em segundos. */
  delay?: number;
  hover?: boolean;
  eager?: boolean;
  class?: string;
}

const {
  src,
  alt,
  sizes,
  ratio = `${src.width} / ${src.height}`,
  reveal = 'up',
  parallax = 1,
  position = '50% 50%',
  delay = 0,
  hover = false,
  eager = false,
  class: className,
  ...rest
} = Astro.props;

const widths = [...new Set([360, 540, 720, 960, src.width].filter((w) => w <= src.width))];
---

<div
  class:list={['media', hover && 'media--hover', className]}
  data-reveal={reveal === 'none' ? undefined : `clip-${reveal}`}
  style={`--ratio:${ratio};--pos:${position};--d:${delay}s`}
  {...rest}
>
  <div class="media__clip">
    <div class="media__plx" data-plx={parallax ? 'frame' : undefined} data-plx-amount={parallax || undefined}>
      <div class="media__zoom">
        <Picture
          src={src}
          alt={alt}
          formats={['avif', 'webp']}
          widths={widths}
          sizes={sizes}
          quality={68}
          loading={eager ? 'eager' : 'lazy'}
          decoding="async"
        />
      </div>
    </div>
  </div>
</div>
