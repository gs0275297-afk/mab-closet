---
/**
 * CURADORIA — quatro capítulos em composição editorial (não é uma grade
 * de produtos). Cada capítulo tem um tamanho, um ponto de entrada e um
 * título ancorado de um jeito diferente.
 *
 * TODO(MAB): os nomes e textos dos capítulos foram criados a partir das
 * fotos enviadas. Ajuste à vontade no array `chapters` abaixo.
 */
import type { ImageMetadata } from 'astro';
import Media from './ui/Media.astro';
import SectionLabel from './ui/SectionLabel.astro';
import Arrow from './ui/Arrow.astro';
import { whatsapp } from '../data/site';

import halter from '../assets/images/essenciais-halter-renda.jpg';
import tee from '../assets/images/casual-tee-flores.jpg';
import listrado from '../assets/images/conjunto-listrado-andando.jpg';
import cetim from '../assets/images/ocasiao-cetim-perfil.jpg';

interface Chapter {
  title: string;
  text: string;
  src: ImageMetadata;
  alt: string;
  ratio: string;
  position?: string;
  sizes: string;
  reveal: 'up' | 'down' | 'left' | 'right';
}

const chapters: Chapter[] = [
  {
    title: 'Essenciais',
    text: 'A base de tudo. Cortes limpos e tecidos que atravessam estações.',
    src: halter,
    alt: 'Blusa frente única de cetim verde-menta com gola degagê e barra de renda, usada com jeans claro',
    ratio: '4 / 5',
    position: '50% 30%',
    sizes: '(min-width: 64rem) 46vw, 84vw',
    reveal: 'up',
  },
  {
    title: 'Casual',
    text: 'O dia a dia com intenção: conforto que não abre mão do detalhe.',
    src: tee,
    alt: 'Camiseta branca com aplicação de flores de organza marrom',
    ratio: '5 / 6',
    sizes: '(min-width: 64rem) 30vw, 70vw',
    reveal: 'left',
  },
  {
    title: 'Conjuntos',
    text: 'Pensados para funcionar juntos — e também separados.',
    src: listrado,
    alt: 'Conjunto de camisa e calça ampla em listras rosa e off-white',
    ratio: '3 / 4',
    position: '50% 40%',
    sizes: '(min-width: 64rem) 30vw, 70vw',
    reveal: 'right',
  },
  {
    title: 'Ocasião',
    text: 'Para as noites e as datas que pedem algo a mais.',
    src: cetim,
    alt: 'Conjunto de cetim amarelo-manteiga com blusa de gola alta e cinto de tachas',
    ratio: '4 / 5',
    position: '50% 30%',
    sizes: '(min-width: 64rem) 46vw, 84vw',
    reveal: 'up',
  },
];
---

<section class="curadoria" id="colecoes">
  <div class="wrap">
    <header class="curadoria__head">
      <SectionLabel n="02" text="Curadoria" />
      <h2 class="curadoria__title display" data-reveal="lines">
        <span class="line"><span>A curadoria,</span></span>
        <span class="line"><span><em class="accent">em quatro capítulos.</em></span></span>
      </h2>
    </header>

    <ol class="chapters">
      {
        chapters.map((chapter, index) => {
          const number = String(index + 1).padStart(2, '0');
          return (
            <li class={`chapter chapter--${index + 1}`}>
              <div class="chapter__visual">
                <Media
                  src={chapter.src}
                  alt={chapter.alt}
                  ratio={chapter.ratio}
                  position={chapter.position}
                  sizes={chapter.sizes}
                  reveal={chapter.reveal}
                  hover
                />
                <h3 class="chapter__title display" data-plx="y" data-plx-amount="34">
                  {chapter.title}
                </h3>
              </div>

              <div class="chapter__meta" data-reveal="fade">
                <span class="chapter__n numeral" aria-hidden="true">{number}</span>
                <div>
                  <p class="body">{chapter.text}</p>
                  <a
                    class="label link link--on link--olive"
                    href={whatsapp(`Olá! Vim pelo site e gostaria de conhecer a seleção "${chapter.title}" da MAB Closet.`)}
                    target="_blank"
                    rel="noopener"
                    aria-label={`Ver a seleção ${chapter.title} pelo WhatsApp`}
                  >
                    Ver pelo WhatsApp
                    <Arrow />
                  </a>
                </div>
              </div>
            </li>
          );
        })
      }
    </ol>
  </div>
</section>

<style>
  .curadoria {
    padding-block: calc(var(--section) * 0.6) var(--section);
  }

  .curadoria__head {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(1rem, 2vw, 2rem);
    align-items: start;
    margin-bottom: clamp(4rem, 9vw, 9rem);
    padding-top: clamp(2.5rem, 4vw, 4rem);
    border-top: 1px solid var(--line);
  }

  .curadoria__head > :global(.section-label) {
    grid-column: 1 / span 2;
    margin-top: 1.2rem;
  }

  .curadoria__title {
    grid-column: 3 / -1;
    font-size: clamp(2.9rem, 8.6vw, 10.5rem);
    line-height: 0.92;
    letter-spacing: -0.028em;
  }

  .curadoria__title .line:nth-child(2) {
    margin-left: 0.85em;
  }

  /* ---------- Composição ---------- */

  .chapters {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(1rem, 2vw, 2rem);
    row-gap: clamp(6rem, 12vw, 13rem);
    align-items: start;
  }

  .chapter--1 {
    grid-column: 1 / span 6;
  }

  .chapter--2 {
    grid-column: 9 / span 4;
    margin-top: clamp(9rem, 24vw, 28rem);
  }

  .chapter--3 {
    grid-column: 2 / span 4;
  }

  .chapter--4 {
    grid-column: 7 / span 6;
    margin-top: clamp(6rem, 13vw, 15rem);
  }

  .chapter__visual {
    position: relative;
  }

  .chapter__title {
    position: absolute;
    z-index: 2;
    font-size: clamp(3.4rem, 9vw, 11.25rem);
    font-weight: 400; /* cruza fotografias: um peso acima */
    line-height: 1;
    letter-spacing: -0.03em;
    white-space: nowrap;
    pointer-events: none;
  }

  /* 01 — sai pelo canto superior direito, ocupando o vazio ao lado */
  .chapter--1 .chapter__title {
    top: 7%;
    left: 86%;
  }

  /* 02 — encosta na foto pela esquerda, ocupando o vão entre as duas imagens
     (a foto é escura: o título não a sobrepõe) */
  .chapter--2 .chapter__title {
    bottom: 9%;
    right: calc(100% + 0.1em);
  }

  /* 03 — atravessa a base da foto */
  .chapter--3 .chapter__title {
    bottom: -0.4em;
    left: -22%;
  }

  /* 04 — faz a ponte entre as duas fotos, no alto */
  .chapter--4 .chapter__title {
    top: 9%;
    right: 73%;
  }

  .chapter__meta {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .chapter--3 .chapter__meta {
    margin-top: clamp(3.5rem, 6vw, 6.5rem);
  }

  .chapter__n {
    padding-top: 0.2em;
    color: var(--olive);
    font-size: 1.5rem;
  }

  .chapter__meta .body {
    max-width: 30ch;
    margin-bottom: 1rem;
  }

  /* ---------- Tablet e celular: coluna única, alinhamentos alternados ---------- */

  @media (max-width: 63.999rem) {
    .curadoria__head > :global(.section-label) {
      grid-column: 1 / -1;
      margin: 0 0 2.25rem;
    }

    .curadoria__title {
      grid-column: 1 / -1;
      font-size: clamp(2.9rem, 12.4vw, 7rem);
    }

    .curadoria__title .line:nth-child(2) {
      margin-left: 0;
    }

    .chapters {
      display: flex;
      flex-direction: column;
      gap: clamp(5.5rem, 16vw, 9rem);
    }

    .chapter {
      width: 84%;
      margin-top: 0;
    }

    .chapter:nth-child(even) {
      width: 70%;
      align-self: flex-end;
    }

    .chapter {
      --title: clamp(3.5rem, 17.5vw, 8.5rem);
    }

    .chapter__title {
      font-size: var(--title);
    }

    /* fotos claras: o título atravessa a base da imagem */
    .chapter--1 .chapter__title,
    .chapter--3 .chapter__title {
      top: auto;
      bottom: -0.42em;
      left: auto;
      right: -16%;
    }

    /* fotos mais escuras: o título encosta na base, sem sobrepor */
    .chapter--2 .chapter__title,
    .chapter--4 .chapter__title {
      top: auto;
      bottom: -1.02em;
      right: auto;
      left: -38%;
    }

    .chapter__meta,
    .chapter--3 .chapter__meta {
      grid-template-columns: 1fr;
      gap: 0.75rem;
      margin-top: clamp(3.25rem, 11vw, 6rem);
    }

    .chapter--2 .chapter__meta,
    .chapter--4 .chapter__meta {
      margin-top: calc(var(--title) * 1.3);
    }

    .chapter__n {
      padding-top: 0;
    }
  }
</style>
