---
/**
 * HERO — díptico de campanha.
 * O mesmo look, de frente e de costas, ocupa a tela inteira como uma única
 * imagem de campanha. No celular, as duas fotos se alternam em fusão lenta.
 *
 * Camadas de cada painel (de fora para dentro):
 *   .hero__panel   recorte
 *   .hero__scroll  parallax de rolagem      (--p, definido em main.ts)
 *   .hero__pointer deriva com o ponteiro    (--mx / --my)
 *   picture        zoom cinematográfico de abertura (CSS)
 */
import { Picture } from 'astro:assets';
import frente from '../assets/images/hero-frente.jpg';
import costas from '../assets/images/hero-costas.jpg';

const widths = [480, 720, 960, 1150];
const sizes = '(min-width: 40rem) 50vw, 100vw';
---

<section class="hero" id="inicio" data-hero>
  <div class="hero__stage">
    <div class="hero__panel hero__panel--a">
      <div class="hero__scroll">
        <div class="hero__pointer">
          <Picture
            src={frente}
            alt="Top branco tomara que caia com peplum e calça de alfaiataria cáqui de pernas amplas, vistos de frente"
            formats={['avif', 'webp']}
            widths={widths}
            sizes={sizes}
            quality={72}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>
      </div>
    </div>

    <div class="hero__panel hero__panel--b">
      <div class="hero__scroll">
        <div class="hero__pointer">
          <Picture
            src={costas}
            alt="O mesmo look visto de costas, com o top branco de costas em lastex"
            formats={['avif', 'webp']}
            widths={widths}
            sizes={sizes}
            quality={72}
            loading="eager"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </div>

  <div class="hero__veil hero__veil--top" aria-hidden="true"></div>
  <div class="hero__veil hero__veil--bottom" aria-hidden="true"></div>

  <p class="hero__caption label" aria-hidden="true">Frente <span></span> Costas</p>

  <div class="hero__content">
    <h1 class="hero__title display">
      <span class="sr-only">MAB Closet — moda feminina em Três Lagoas, MS.</span>
      <span class="line"><span>Presença</span></span>
      <span class="line hero__title-b"><span><em>se veste.</em></span></span>
    </h1>

    <div class="hero__foot">
      <p class="hero__what label">
        Moda feminina <span aria-hidden="true">·</span>
        <span class="hero__what-long">Curadoria</span> multimarcas
      </p>
      <p class="hero__where label">Shopping Galeria <span aria-hidden="true">·</span> Três Lagoas — MS</p>
      <a class="hero__next label" href="#marca" aria-label="Role para descobrir a marca">
        <span>Role para descobrir</span>
        <span class="hero__next-line" aria-hidden="true"></span>
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    --p: 0;
    --mx: 0;
    --my: 0;
    position: relative;
    height: 100vh;
    height: 100svh;
    min-height: 34rem;
    overflow: hidden;
    overflow: clip;
    background: var(--bone);
  }

  /* ---------- Fotografia ---------- */

  .hero__stage {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3px;
  }

  .hero__panel {
    position: relative;
    overflow: hidden;
    background: #d2d3cb; /* tom da parede das fotos, enquanto carregam */
  }

  .hero__scroll,
  .hero__pointer {
    position: absolute;
    inset: 0;
  }

  .hero__scroll {
    transform: translate3d(0, calc(var(--p) * 13%), 0) scale(calc(1 + var(--p) * 0.05));
    will-change: transform;
  }

  .hero__pointer {
    inset: -1.25rem;
    transform: translate3d(calc(var(--mx) * var(--drift, -0.6rem)), calc(var(--my) * -0.4rem), 0);
  }

  .hero__panel--b .hero__pointer {
    --drift: 0.6rem;
  }

  .hero__stage :global(picture),
  .hero__stage :global(img) {
    width: 100%;
    height: 100%;
  }

  .hero__stage :global(img) {
    object-fit: cover;
    object-position: 50% 26%;
    animation: hero-zoom 3.4s var(--ease) calc(var(--intro) - 0.15s) both;
  }

  .hero__panel--b :global(img) {
    object-position: 58% 26%;
    animation-duration: 3.9s;
  }

  @keyframes hero-zoom {
    from {
      transform: scale(1.24);
    }
  }

  /* Véus claros no topo e na base: a fotografia se dissolve no off-white da
     página, e cabeçalho e rodapé do hero permanecem legíveis sobre qualquer
     parte da imagem, em qualquer proporção de tela */
  .hero__veil {
    position: absolute;
    inset-inline: 0;
    pointer-events: none;
  }

  .hero__veil--top {
    top: 0;
    height: clamp(6.5rem, 15vh, 8.5rem);
    background: linear-gradient(
      to bottom,
      rgb(243 240 232 / 0.94) 0%,
      rgb(243 240 232 / 0.74) 42%,
      rgb(243 240 232 / 0.26) 76%,
      rgb(243 240 232 / 0) 100%
    );
  }

  .hero__veil--bottom {
    bottom: 0;
    height: clamp(6rem, 14vh, 8rem);
    background: linear-gradient(
      to top,
      rgb(243 240 232 / 0.9) 0%,
      rgb(243 240 232 / 0.72) 40%,
      rgb(243 240 232 / 0.24) 76%,
      rgb(243 240 232 / 0) 100%
    );
  }

  /* ---------- Tipografia ---------- */

  .hero__content {
    position: absolute;
    inset: auto 0 0 0;
    padding: 0 var(--gutter) clamp(1.25rem, 2.4vw, 2.25rem);
    transform: translate3d(0, calc(var(--p) * -2.25rem), 0);
  }

  .hero__title {
    font-size: clamp(5rem, min(16.4vw, 25.5vh), 20.5rem);
    font-weight: 400; /* sobre a fotografia, um peso acima do restante */
    line-height: 0.76;
    letter-spacing: -0.035em;
  }

  .hero__title em {
    font-weight: 400;
  }

  .hero__title .line > span {
    animation: hero-line 1.7s var(--ease) calc(var(--intro) + 0.35s) both;
  }

  .hero__title-b {
    margin-left: 25vw;
  }

  .hero__title-b > span {
    animation-delay: calc(var(--intro) + 0.5s) !important;
  }

  .hero__foot {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1.5rem;
    margin-top: clamp(1.25rem, 2.2vw, 2.25rem);
    padding-top: 1.1rem;
    border-top: 1px solid rgb(32 33 36 / 0.3);
    animation: hero-fade 1.6s var(--ease) calc(var(--intro) + 1.1s) both;
  }

  .hero__next {
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    min-height: 2.75rem;
  }

  .hero__next-line {
    position: relative;
    display: block;
    width: 3.5rem;
    height: 1px;
    overflow: hidden;
    background: rgb(32 33 36 / 0.25);
  }

  .hero__next-line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: currentColor;
    animation: hero-next 2.6s var(--ease-io) infinite;
  }

  .hero__caption {
    position: absolute;
    top: 50%;
    right: calc(var(--gutter) * 0.5);
    display: flex;
    align-items: center;
    gap: 1em;
    writing-mode: vertical-rl;
    transform: translateY(-50%) rotate(180deg);
    animation: hero-fade 1.6s var(--ease) calc(var(--intro) + 1.25s) both;
  }

  .hero__caption span {
    display: block;
    width: 1px;
    height: 2.5rem;
    background: currentColor;
    opacity: 0.45;
  }

  .hero__foot .label {
    white-space: nowrap;
  }

  /* ---------- Tablet: rodapé do hero em duas pontas ---------- */

  @media (max-width: 63.999rem) {
    .hero__where {
      display: none;
    }

    .hero__foot {
      grid-template-columns: 1fr auto;
    }
  }

  @keyframes hero-line {
    from {
      transform: translate3d(0, 118%, 0);
    }
  }

  @keyframes hero-fade {
    from {
      opacity: 0;
      transform: translate3d(0, 0.9rem, 0);
    }
  }

  .hero__caption {
    animation-name: hero-fade-plain;
  }

  @keyframes hero-fade-plain {
    from {
      opacity: 0;
    }
  }

  @keyframes hero-next {
    0% {
      transform: translate3d(-101%, 0, 0);
    }
    50% {
      transform: none;
    }
    100% {
      transform: translate3d(101%, 0, 0);
    }
  }

  /* ---------- Celular: uma foto por vez, em fusão ---------- */

  @media (max-width: 39.999rem) {
    .hero__stage {
      display: block;
    }

    .hero__panel {
      position: absolute;
      inset: 0;
    }

    .hero__panel--b {
      animation: hero-swap 13s var(--ease-io) calc(var(--intro) + 4.5s) infinite both;
    }

    .hero__stage :global(img) {
      object-position: 50% 30%;
    }

    .hero__panel--b :global(img) {
      object-position: 54% 30%;
    }

    .hero__title {
      font-size: clamp(4.25rem, min(25vw, 15.5vh), 8.5rem);
      line-height: 0.8;
    }

    .hero__title-b {
      margin-left: 16vw;
    }

    .hero__caption,
    .hero__next > span:first-child {
      display: none;
    }

    .hero__foot {
      gap: 1rem;
    }

    .hero__what {
      font-size: 0.625rem;
      letter-spacing: 0.2em;
    }

    .hero__next-line {
      width: 2.25rem;
    }

    @keyframes hero-swap {
      0%,
      100% {
        opacity: 0;
      }
      12%,
      50% {
        opacity: 1;
      }
      62% {
        opacity: 0;
      }
    }
  }

  @media (max-width: 23.5rem) {
    .hero__what-long {
      display: none;
    }
  }

  /* ---------- Menos movimento: imagem estática, sem deriva nem fusão ---------- */

  :global(.reduce-motion) .hero__scroll,
  :global(.reduce-motion) .hero__pointer,
  :global(.reduce-motion) .hero__content {
    transform: none;
  }

  :global(.reduce-motion) .hero__pointer {
    inset: 0;
  }

  :global(.reduce-motion) .hero__next-line::after {
    animation: none;
  }

  @media (max-width: 39.999rem) {
    :global(.reduce-motion) .hero__panel--b {
      display: none;
    }
  }
</style>
